<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The App Store requires the sandbox. The App Store version has no network access
         (no update check). -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Windows are moved by the "Quadra" shortcut, which Quadra runs in the background through
         Shortcuts Events (its "run" scripting access group). -->
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.shortcuts.events</key>
        <array>
            <string>com.apple.shortcuts.run</string>
        </array>
    </dict>
</dict>
</plist>
